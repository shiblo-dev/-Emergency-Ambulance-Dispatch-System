model EmergencyRequest {
  id          String        @id @default(uuid())

  patientId   String
  patient     User          @relation(fields: [patientId], references: [id])

  priority    Priority
  status      RequestStatus @default(REQUESTED)

  // Pickup location
  pickupAddress   String
  pickupLatitude  Float
  pickupLongitude Float

  // Assigned ambulance (nullable — dispatch হওয়ার আগে null থাকবে)
  ambulanceId String?
  ambulance   Ambulance?    @relation(fields: [ambulanceId], references: [id])

  // Selected hospital (nullable — hospital selection স্টেপের আগে null)
  hospitalId  String?
  hospital    Hospital?     @relation(fields: [hospitalId], references: [id])

  description String?       // কী emergency, symptoms ইত্যাদি

  isDeleted   Boolean       @default(false)
  deletedAt   DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  payment     Payment?

  @@map("emergency_requests")
}