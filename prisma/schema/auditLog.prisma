model AuditLog {
  id         String   @id @default(uuid())

  userId     String
  user       User     @relation(fields: [userId], references: [id])

  action     String
  entityType String
  entityId   String
  oldValue   Json?
  newValue   Json?

  ipAddress  String?
  createdAt  DateTime @default(now())

  @@map("audit_logs")
}